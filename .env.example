# Copy this file to .env and fill in real values.

# Database connection. Backs the admin panel's accounts and sessions
# (see prisma/schema.prisma). Note the "@" between password and host.
DATABASE_URL="mysql://user:password@localhost:3306/mr_group"

# The first admin account, created by `npm run db:seed`. There is no way to
# sign in to /admin before this has been run at least once.
#
# Deliberately NOTHING here. `npm run db:seed` always prompts for username,
# email, and password — the password with hidden input — so the account you
# create is always the one you intended, not a stale .env value, and the
# plaintext password never touches disk or your shell history. Only the
# scrypt hash is stored, in the database. Rotate the password later from
# /admin/settings.
#
# ADMIN_NAME / ADMIN_EMAIL / ADMIN_PASSWORD are read ONLY for non-interactive
# seeding (CI, container builds), where there's no TTY to prompt on. Don't
# set them here — pass them as one-shot variables instead:
#   ADMIN_NAME='Admin' ADMIN_EMAIL='you@example.com' ADMIN_PASSWORD='your-password' npm run db:seed

# Root domain for the main site. Company cards link to "<subdomain>.<this>"
# and src/proxy.ts strips this suffix to detect a company subdomain request.
# Leave unset in local dev — defaults to "localhost:3000", where modern
# browsers resolve any "*.localhost" subdomain to 127.0.0.1 automatically.
NEXT_PUBLIC_ROOT_DOMAIN="mrgroup.com"

# SMTP credentials for the /contact page's contact form (see src/lib/mailer.ts).
# Any SMTP provider works (Gmail, Outlook, your own mail server, a transactional
# email provider's SMTP endpoint, etc). For Gmail, use an "App Password", not
# your regular account password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
# Optional — defaults to SMTP_USER if omitted.
SMTP_FROM="MR Group Website <no-reply@mrgroup.example>"
# Where contact form submissions are delivered — defaults to SMTP_USER if omitted.
CONTACT_EMAIL_TO="info@mrgroup.example"
